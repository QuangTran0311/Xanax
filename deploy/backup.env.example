# Cấu hình backup off-site — cài thành /etc/xanax/backup.env
#
#   sudo install -m 0600 -o root -g root /opt/xanax/deploy/backup.env.example \
#       /etc/xanax/backup.env
#
# KHÔNG có file này thì backup.sh vẫn chạy y như cũ, chỉ bỏ qua bước đẩy ra
# ngoài. Nhờ vậy máy dev hoặc máy chưa cấu hình rclone không bị gãy.

# Remote rclone nhận backup. PHẢI là remote kiểu `crypt`.
#
# Archive chứa backend/.env, tức là chứa XANAX_SECRET_KEY — khóa giải mã toàn bộ
# token skill. Đẩy nguyên bản lên cloud là mang khóa đó ra khỏi tầm kiểm soát.
# Cấu hình hai remote: `r2` (S3/R2 thật) và `r2crypt` (crypt, trỏ vào
# r2:xanax-backup), rồi chỉ dùng remote crypt ở đây.
#
# >>> PASSPHRASE CỦA REMOTE CRYPT PHẢI ĐƯỢC CẤT TRONG TRÌNH QUẢN LÝ MẬT KHẨU
# >>> NGAY LÚC TẠO. Nó chỉ nằm trong rclone.conf trên VPS — mà VPS chết chính là
# >>> kịch bản backup off-site sinh ra để phòng. Mất passphrase = backup thành rác.
OFFSITE_REMOTE=r2crypt:

# Số ngày giữ bản backup trên cloud. Để trống hoặc 0 = không tự xóa gì cả.
# Local giữ theo SỐ LƯỢNG (KEEP_BACKUPS, mặc định 14), cloud giữ theo TUỔI.
OFFSITE_KEEP_DAYS=30

# File cấu hình rclone. Backup chạy bằng root nên mặc định là của root.
RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# Giới hạn băng thông upload để backup lúc 2 giờ sáng không ăn hết đường truyền.
# Cú pháp theo rclone: 2M, 500k, off... Để trống là không giới hạn.
RCLONE_BWLIMIT=4M
