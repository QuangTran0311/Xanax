# Cấu hình cảnh báo Telegram — cài thành /etc/xanax/alert.env
#
#   sudo install -d -m 0750 -o root -g root /etc/xanax
#   sudo install -m 0600 -o root -g root /opt/xanax/deploy/alert.env.example \
#       /etc/xanax/alert.env
#   sudo nano /etc/xanax/alert.env
#
# File này chứa bot token nên PHẢI là 0600, owner root. Đừng để lọt vào Git.

# Token do @BotFather cấp khi tạo bot.
TELEGRAM_BOT_TOKEN=

# ID cuộc trò chuyện nhận cảnh báo. Cách lấy: nhắn cho bot một câu bất kỳ rồi
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | python3 -m json.tool
# và đọc result[].message.chat.id
TELEGRAM_CHAT_ID=

# Tên máy hiển thị trong tin nhắn. Bỏ trống thì lấy `hostname -s`.
# Đặt tay khi bạn có nhiều VPS để khỏi phải đoán tin nhắn đến từ máy nào.
ALERT_HOSTNAME=
