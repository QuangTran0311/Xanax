# Cấu hình giám sát — cài thành /etc/xanax/monitor.env
#
#   sudo install -m 0644 -o root -g root /opt/xanax/deploy/monitor.env.example \
#       /etc/xanax/monitor.env
#
# Dùng chung cho healthcheck.sh, provider-check.sh, disk-check.sh và
# backup-freshness.sh.
# Không chứa secret nên 0644 là đủ; secret Telegram nằm ở alert.env.

# ── healthcheck.sh ────────────────────────────────────────────────────────
# Kiểm tra từ trong máy: bắt được app chết, database hỏng, worker treo.
HEALTH_URL_LOCAL=http://127.0.0.1:8000/api/health/ready

# Kiểm tra từ vòng ngoài: bắt được trường hợp app vẫn sống nhưng Caddy chết,
# chứng chỉ hết hạn hoặc DNS sai — những thứ check loopback không bao giờ thấy.
# Để trống nếu chưa có domain.
HEALTH_URL_PUBLIC=https://xanax.example.com/api/health

# Số lần hỏng liên tiếp trước khi gửi cảnh báo. Đặt 2 để một lần timeout đơn lẻ
# lúc service đang restart không làm phiền bạn.
HEALTH_FAIL_THRESHOLD=2

# ── provider-check.sh ──────────────────────────────────────────────────
# Endpoint này gọi CLI thật, nên chỉ đi qua loopback và phải kèm X-API-Key.
PROVIDER_URL=http://127.0.0.1:8000/api/health/providers

# Script chỉ grep đúng dòng HUB_API_KEY, tuyệt đối không source file này.
PROVIDER_HUB_ENV=/opt/xanax/backend/.env

# Endpoint chặn mỗi entry ở 30 giây; chừa 15 giây cho HTTP và serialize.
PROVIDER_MAX_TIME_SECONDS=45

# ── disk-check.sh ─────────────────────────────────────────────────────────
DISK_WARN_PERCENT=80
DISK_CRIT_PERCENT=90
# Các đường dẫn cần theo dõi, cách nhau bằng khoảng trắng. Trùng filesystem thì
# script tự gộp, không báo hai lần cho cùng một ổ.
DISK_PATHS="/opt/xanax /var/backups/xanax /var/log"

# ── backup-freshness.sh ───────────────────────────────────────────────────
# Backup chạy hằng ngày, nên quá 36 giờ không có bản mới là có chuyện. Ngưỡng
# này cố ý rộng hơn 24 giờ để RandomizedDelaySec và một lần lỡ nhịp không báo động.
BACKUP_MAX_AGE_HOURS=36
BACKUP_DIR=/var/backups/xanax

# Kiểm tra luôn bản trên cloud. Cần rclone và /etc/xanax/backup.env.
# Đây là thứ bắt được lỗi "timer im lặng không chạy nữa" — loại lỗi mà
# OnFailure không bao giờ thấy vì chẳng có gì thất bại cả.
BACKUP_CHECK_OFFSITE=1
