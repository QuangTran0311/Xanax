[Unit]
Description=Xanax FastAPI service
Wants=network-online.target
After=network-online.target

# Mặc định của systemd là 5 lần khởi động trong 10 giây; vượt ngưỡng thì unit bị
# bỏ mặc ở trạng thái failed VĨNH VIỄN, không thử lại nữa. Với Restart=always
# bên dưới (RestartSec=5s), một sự cố tạm thời như database bận hay mạng chưa
# lên có thể đốt hết hạn mức đó rồi để web chết luôn tới khi có người vào xem.
# Nới thành 10 lần trong 5 phút: vẫn chặn được vòng lặp khởi động vô tận, nhưng
# không đầu hàng vì vài lần chết liên tiếp.
StartLimitIntervalSec=300
StartLimitBurst=10

# Hết hạn mức trên là im lặng chết. Bắn Telegram ngay tại thời điểm đó.
OnFailure=xanax-alert@%n.service

[Service]
Type=simple
User=xanax
Group=xanax

# PLACEHOLDER: sửa mọi đường /opt/xanax nếu mã nguồn được đặt ở nơi khác.
WorkingDirectory=/opt/xanax/backend
EnvironmentFile=/opt/xanax/backend/.env
Environment="PYTHONUNBUFFERED=1"
# MCP SDK không tự kế thừa HOME trên Linux. Khai báo tường minh để rembg dùng
# đúng cache model của user xanax, không tải lại hoặc thử ghi vào nơi khác.
Environment="HOME=/home/xanax"
Environment="U2NET_HOME=/home/xanax/.u2net"
# rembg giải phóng bộ nhớ ở tầng Python nhưng glibc vẫn có thể ôm các arena, không
# trả về OS. Giới hạn số arena để giảm phần RSS bị giữ lại vô ích.
Environment="MALLOC_ARENA_MAX=2"
# systemd không đọc PATH từ shell đăng nhập. Giữ các thư mục CLI của user xanax ở đây.
Environment="PATH=/opt/xanax/.venv/bin:/home/xanax/.local/bin:/home/xanax/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/xanax/.venv/bin/python /opt/xanax/backend/main.py

Restart=always
RestartSec=5s

# Toàn bộ claude/codex CLI và rembg do app sinh ra nằm cùng cgroup với service này.
# MemoryHigh kìm trước (throttle và đẩy trang ít dùng ra swap); MemoryMax mới là
# trần cứng có thể giết tiến trình. Đặt hai mức cách nhau để máy còn cơ hội hồi
# phục bằng cách chạy chậm lại, thay vì vừa chạm ngưỡng đã giết ngay.
#
# Bài học từ máy cũ chỉ có khoảng 5,8 GiB RAM: đỉnh 5.562-5.628 MiB từng ghi lại
# là đỉnh BỊ MÁY CŨ CẮT CỤT. Khi không còn RAM để cấp thêm, kernel reclaim nên
# tiến trình vẫn chạy nhưng RSS bị ép xuống; không được suy ngược từ "máy chạy
# được" thành "model chỉ cần chừng đó".
#
# Đo lại ngày 18/08/2026 trên máy 8 GB có MemTotal thật 8131780 kB (khoảng
# 7,75 GiB): birefnet-general-lite đạt 6.105-6.562 MiB, ổn định ở 6.562 MiB từ
# lượt thứ hai. Chạy trần và chạy đúng OMP_NUM_THREADS=4 + MALLOC_ARENA_MAX=2
# như production lần lượt đạt 6.537 và 6.562 MiB, chỉ lệch 0,4%. Cộng khoảng
# 300 MiB của web, đỉnh thật trong cgroup xấp xỉ 6,7 GiB, dưới MemoryHigh=7G nên
# lượt inference bình thường không bị throttle.
#
# MemoryMax=7.5G còn chừa khoảng 250 MiB RAM vật lý cho OS, Caddy và journald,
# cộng swap 4 GiB (swappiness=10) làm đệm. Khoảng này cố ý hẹp nhưng MemoryHigh=7G
# sẽ kìm trước khi cgroup chạm trần cứng. KHÔNG được xóa swap đó.
#
# Chốt RAM của nhóm birefnet là 6,5 GiB phần CÒN LẠI trong cgroup. Không đặt chốt
# đúng 7 GiB: với web dao động 300-800 MiB dưới MemoryMax=7.5G, phần còn lại sẽ
# quanh đúng 7 GiB và skill lúc chạy được lúc không. Muốn hạ giới hạn phải đổi
# cả chốt trong MODEL_MEMORY_REQUIREMENTS hoặc đổi model mặc định; birefnet là
# model duy nhất đã đo được xử lý sạch cả nền tối lẫn bóng đổ trên bàn gỗ.
#
# Giữ giới hạn cgroup để khi vượt trần, OOM chỉ chọn nạn nhân trong cgroup Xanax,
# không bắn nhầm Caddy hay sshd và làm mất đường vào máy.
MemoryHigh=7G
MemoryMax=7.5G

# CẢNH BÁO: systemctl revert cũng xóa drop-in bền vững ở /etc; chạy
# systemctl cat xanax để kiểm tra trước. Sau khi copy unit vào /etc/systemd/system/,
# chạy systemctl revert xanax.service để xóa drop-in --runtime còn nằm trong
# /run/systemd/system.control/, rồi daemon-reload, restart xanax và xác nhận bằng
# systemctl show xanax -p MemoryHigh -p MemoryMax.

# subprocess_util.py dùng 1 process CLI và 2 thread đọc pipe cho mỗi lần chạy.
# Nếu process/thread bị rò, biến nó thành lỗi nhìn thấy được thay vì để cả máy
# cạn task rồi chết.
TasksMax=512

NoNewPrivileges=true
PrivateTmp=true
# full chỉ khóa ghi /usr, /boot, /efi và /etc; /opt/xanax/backend/data vẫn ghi được.
# Không dùng strict vì app phải ghi SQLite và toàn bộ backend/data.
ProtectSystem=full
# CỐ Ý không bật ProtectHome: claude/codex CLI đọc credential/config trong /home/xanax.
ProtectHome=false
UMask=0027

# stdout/stderr đi vào journald; xem bằng: journalctl -u xanax -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xanax

[Install]
WantedBy=multi-user.target
