[Unit]
# Bản diễn tập restore. KHÔNG BAO GIỜ enable unit này — nó chỉ sống vài phút
# trong lúc drill-restore.sh chạy, rồi bị teardown.
Description=Xanax (bản diễn tập restore, KHÔNG phải production)

[Service]
Type=simple
User=xanax
Group=xanax

WorkingDirectory=/opt/xanax-drill/backend

# `-` ở đầu: lần diễn tập đầu tiên chưa có .env (restore.sh mới là thứ đặt nó
# vào chỗ), unit vẫn phải nạp được thay vì chết vì thiếu file.
EnvironmentFile=-/opt/xanax-drill/backend/.env

# File đè, do drill-restore.sh sinh ra trước khi khởi động. KHÔNG có dấu `-`:
# thiếu nó thì unit phải chết ngay, vì chạy với .env nguyên bản nghĩa là drill
# lấy cổng 8000 và database của production.
#
# TẠI SAO KHÔNG DÙNG `Environment=`: systemd đọc EnvironmentFile SAU và nó ĐÈ LÊN
# Environment=, bất kể thứ tự viết trong file unit. Bản trước của unit này dùng
# Environment="HUB_PORT=8001" và bị .env đè lại thành 8000, khiến drill lao vào
# đúng cổng của production rồi chết vì "address already in use".
#
# Nhiều EnvironmentFile thì đọc theo thứ tự liệt kê, file sau đè file trước — nên
# đây mới là cách đúng để áp cấu hình riêng cho drill.
EnvironmentFile=/opt/xanax-drill/drill-overrides.env

Environment="PYTHONUNBUFFERED=1"

# Dùng chung interpreter của production: chỉ ĐỌC, không ghi gì vào /opt/xanax,
# và tránh phải dựng venv mới (mất vài phút và cần mạng) cho mỗi lần diễn tập.
ExecStart=/opt/xanax/.venv/bin/python /opt/xanax-drill/backend/main.py

# Diễn tập mà tự khởi động lại thì che mất đúng thứ cần phát hiện: bản restore
# không chạy được. Hỏng là phải hỏng cho thấy.
Restart=no

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=xanax-drill

# CỐ Ý không có [Install]: unit này không được phép tự chạy lúc boot.
