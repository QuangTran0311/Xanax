# Các file được đưa lên Linux phải luôn là LF dù máy phát triển bật core.autocrlf=true.
*.sh text eol=lf
*.service text eol=lf
Caddyfile text eol=lf
*.timer text eol=lf
deploy/*.conf text eol=lf
# Các file này được `source` bằng bash trên VPS. Dính CRLF thì giá trị biến sẽ
# mang theo ký tự \r ở cuối — ví dụ OFFSITE_KEEP_DAYS thành "30\r" — và lỗi sinh
# ra rất khó đoán.
deploy/*.env.example text eol=lf
# Lock Python do pip trên Linux đọc và phải được commit; không để core.autocrlf
# đổi nó sang CRLF trên máy phát triển Windows.
backend/requirements.lock text eol=lf
