generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NHÓM 1: CONVERSATION CORE ───────────────────────────────

model User {
  id           String        @id @default(uuid())
  username     String        @unique @db.VarChar(100)
  email        String?       @unique @db.VarChar(255)
  passwordHash String?       @db.VarChar(255)
  role         String        @default("owner") @db.VarChar(20)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  userSessions UserSession[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique @db.VarChar(512)
  userAgent    String?  @db.VarChar(255)
  ipAddress    String?  @db.VarChar(45)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  title          String?
  status         String    @default("active") @db.VarChar(20)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  totalMessages  Int       @default(0)
  totalToolCalls Int       @default(0)
  totalCostUsd   Float     @default(0)
  summary        String?
  tags           String[]
  metadata       Json?
  createdAt      DateTime  @default(now())

  user           User            @relation(fields: [userId], references: [id])
  messages       Message[]
  toolCalls      ToolCall[]
  artifacts      Artifact[]
  executionLogs  ExecutionLog[]
  modelUsageLogs ModelUsageLog[]
  episode        Episode?
  meetingRoom    MeetingRoom?

  @@map("sessions")
}

model Message {
  id           String   @id @default(uuid())
  sessionId    String
  sequenceNo   Int
  role         String   @db.VarChar(20)
  contentType  String   @default("text") @db.VarChar(30)
  content      String?
  artifactId   String?
  modelId      String?  @db.VarChar(100)
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  session   Session    @relation(fields: [sessionId], references: [id])
  toolCalls ToolCall[]

  @@map("messages")
}

model ToolCall {
  id           String    @id @default(uuid())
  sessionId    String
  messageId    String
  sequenceNo   Int
  toolName     String    @db.VarChar(100)
  inputParams  Json?
  outputResult Json?
  status       String    @default("pending") @db.VarChar(20)
  errorMsg     String?
  latencyMs    Int?
  costUsd      Float     @default(0)
  calledAt     DateTime  @default(now())
  completedAt  DateTime?

  session       Session        @relation(fields: [sessionId], references: [id])
  message       Message        @relation(fields: [messageId], references: [id])
  artifacts     Artifact[]
  executionLogs ExecutionLog[]
  modelUsageLogs ModelUsageLog[]

  @@map("tool_calls")
}

model Artifact {
  id           String   @id @default(uuid())
  sessionId    String
  toolCallId   String?
  artifactType String   @db.VarChar(30)
  fileName     String?  @db.VarChar(255)
  mimeType     String?  @db.VarChar(100)
  sizeBytes    Int?
  storageRef   String
  checksum     String?  @db.VarChar(64)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  session  Session   @relation(fields: [sessionId], references: [id])
  toolCall ToolCall? @relation(fields: [toolCallId], references: [id])

  @@map("artifacts")
}

model ExecutionLog {
  id         String   @id @default(uuid())
  sessionId  String
  toolCallId String?
  level      String   @db.VarChar(10)
  message    String
  context    Json?
  loggedAt   DateTime @default(now())

  session  Session   @relation(fields: [sessionId], references: [id])
  toolCall ToolCall? @relation(fields: [toolCallId], references: [id])

  @@map("execution_logs")
}

// ─── NHÓM 2: MODEL INTELLIGENCE ─────────────────────────────

model ModelRegistry {
  modelId         String   @id @db.VarChar(100)
  provider        String   @db.VarChar(50)
  modality        String   @db.VarChar(20)
  subTypes        String[]
  contextWindow   Int?
  supportsStream  Boolean  @default(true)
  inputFormats    String[]
  outputFormats   String[]
  costPer1kInput  Float?
  costPer1kOutput Float?
  costPerUnit     Float?
  apiEndpoint     String?
  apiKeyRef       String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  notes           String?
  addedAt         DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modelUsageLogs ModelUsageLog[]
  modelScores    ModelScore[]
  meetingMembers MeetingMember[]

  @@map("model_registry")
}

model ModelUsageLog {
  id           String   @id @default(uuid())
  sessionId    String
  toolCallId   String?
  modelId      String   @db.VarChar(100)
  taskType     String   @db.VarChar(50)
  inputTokens  Int?
  outputTokens Int?
  inputChars   Int?
  latencyMs    Int?
  costUsd      Float?
  success      Boolean  @default(true)
  errorMsg     String?
  userRating   Int?
  autoQuality  Float?
  feedbackNote String?
  createdAt    DateTime @default(now())

  session  Session       @relation(fields: [sessionId], references: [id])
  toolCall ToolCall?     @relation(fields: [toolCallId], references: [id])
  model    ModelRegistry @relation(fields: [modelId], references: [modelId])

  @@map("model_usage_logs")
}

model ModelScore {
  id           String   @id @default(uuid())
  modelId      String   @db.VarChar(100)
  taskType     String   @db.VarChar(50)
  avgLatencyMs Float    @default(0)
  avgCostUsd   Float    @default(0)
  successRate  Float    @default(1.0)
  qualityScore Float    @default(0.5)
  sampleCount  Int      @default(0)
  finalScore   Float    @default(0)
  updatedAt    DateTime @updatedAt

  model ModelRegistry @relation(fields: [modelId], references: [modelId])

  @@unique([modelId, taskType])
  @@map("model_scores")
}

model RoutingRule {
  id              String   @id @default(uuid())
  ruleName        String   @unique @db.VarChar(100)
  priority        Int      @default(50)
  modality        String?  @db.VarChar(20)
  conditions      Json
  preferredModels String[]
  excludedModels  String[]
  overrideScore   Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdBy       String   @default("human") @db.VarChar(20)
  notes           String?
  createdAt       DateTime @default(now())

  @@map("routing_rules")
}

// ─── NHÓM 3: SOUL & LONG-TERM MEMORY ────────────────────────

model SoulKnowledge {
  id        String   @id @default(uuid())
  agentId   String   @default("hermes") @db.VarChar(50)
  category  String   @db.VarChar(50)
  key       String   @db.VarChar(100)
  content   String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, key])
  @@map("soul_knowledge")
}

model LearnedPattern {
  id         String    @id @default(uuid())
  agentId    String    @default("hermes") @db.VarChar(50)
  pattern    String
  source     String    @default("auto_learned") @db.VarChar(20)
  confidence Float     @default(0.5)
  useCount   Int       @default(0)
  lastUsed   DateTime?
  createdAt  DateTime  @default(now())

  soulUpdateCandidates SoulUpdateCandidate[]

  @@map("learned_patterns")
}

model SoulUpdateCandidate {
  id               String    @id @default(uuid())
  agentId          String    @default("hermes") @db.VarChar(50)
  suggestedKey     String    @db.VarChar(100)
  suggestedContent String
  reason           String?
  sourcePatternId  String?
  confidence       Float     @default(0.5)
  status           String    @default("pending") @db.VarChar(20)
  reviewedBy       String?   @db.VarChar(100)
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  sourcePattern LearnedPattern? @relation(fields: [sourcePatternId], references: [id])

  @@map("soul_update_candidates")
}

// ─── NHÓM 4: EPISODIC MEMORY ────────────────────────────────

model Episode {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  agentId     String   @default("hermes") @db.VarChar(50)
  taskSummary String?
  keyActions  String[]
  outcome     String?  @db.VarChar(20)
  userRating  Int?
  reflection  String?
  embedding   String?
  createdAt   DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@map("episodes")
}

// ─── NHÓM 5: MEETING ROOM ───────────────────────────────────

model AgentRole {
  id           String   @id @default(uuid())
  roleCode     String   @unique @db.VarChar(20)
  roleName     String   @db.VarChar(100)
  expertise    String?
  systemPrompt String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  members MeetingMember[]

  @@map("agent_roles")
}

model MeetingRoom {
  id        String    @id @default(uuid())
  sessionId String    @unique
  title     String    @db.VarChar(255)
  objective String?
  status    String    @default("opened") @db.VarChar(20)
  openedAt  DateTime  @default(now())
  closedAt  DateTime?

  session Session         @relation(fields: [sessionId], references: [id])
  members MeetingMember[]
  turns   MeetingTurn[]
  reports MeetingReport[]

  @@map("meeting_rooms")
}

model MeetingMember {
  id        String   @id @default(uuid())
  meetingId String
  modelId   String   @db.VarChar(100)
  roleId    String
  isChair   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  meeting         MeetingRoom   @relation(fields: [meetingId], references: [id])
  model           ModelRegistry @relation(fields: [modelId], references: [modelId])
  role            AgentRole     @relation(fields: [roleId], references: [id])
  turns           MeetingTurn[]
  reportsAuthored MeetingReport[]

  @@map("meeting_members")
}

model MeetingTurn {
  id          String   @id @default(uuid())
  meetingId   String
  memberId    String
  turnNo      Int
  turnType    String   @db.VarChar(20)
  addressedTo String?
  content     String
  latencyMs   Int?
  costUsd     Float?
  createdAt   DateTime @default(now())

  meeting MeetingRoom   @relation(fields: [meetingId], references: [id])
  member  MeetingMember @relation(fields: [memberId], references: [id])

  @@map("meeting_turns")
}

model MeetingReport {
  id          String   @id @default(uuid())
  meetingId   String
  authorId    String
  summary     String?
  decisions   String?
  actionItems String?
  createdAt   DateTime @default(now())

  meeting MeetingRoom   @relation(fields: [meetingId], references: [id])
  author  MeetingMember @relation(fields: [authorId], references: [id])

  @@map("meeting_reports")
}
