# Server
PORT=3000
NODE_ENV=development

# Database — đổi thành connection string thật trong .env
DATABASE_URL="postgresql://postgres:password@localhost:5432/hermes_hub"

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# API Auth (tự đặt chuỗi bất kỳ)
HUB_API_KEY=your-secret-key-here

# Optional: các provider khác
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
