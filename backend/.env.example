# ─────────────────────────────────────────
# Xanax Hub Server – Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Server
HUB_HOST=0.0.0.0
HUB_PORT=8000
HUB_DEBUG=true
# HUB_TITLE và HUB_VERSION cố ý KHÔNG khai ở đây.
# Tên và số phiên bản là thuộc tính của mã nguồn, không phải cấu hình theo máy —
# nguồn duy nhất là hub/config.py. Khai lại ở .env thì .env sẽ ĐÈ lên code, và
# sửa version trong config.py sẽ không có tác dụng gì.

# Security
HUB_SECRET_KEY=change-me-to-a-strong-random-secret
HUB_API_KEY=xanax-dev-key-0000
# Keep this stable after first use; changing it makes encrypted skill secrets unreadable.
XANAX_SECRET_KEY=

# Database
# Defaults to the absolute backend/xanax.db path derived by hub/config.py.
# HUB_DATABASE_URL=sqlite+aiosqlite:///D:/xanax/backend/xanax.db

# Hermes Agent
HUB_HERMES_MAX_ITERATIONS=10
HUB_HERMES_MEMORY_TTL=3600
HUB_HERMES_LOG_LEVEL=INFO
HUB_HERMES_GATEWAY_URL=http://localhost:8642
HUB_HERMES_API_KEY=

# Task Queue
HUB_TASK_QUEUE_MAX_SIZE=1000
HUB_TASK_WORKER_COUNT=4

# Optional: LLM backend (for planning)
HUB_LLM_API_BASE=http://localhost:11434  # Ollama or any OpenAI-compatible endpoint
HUB_LLM_MODEL=hermes3
HUB_LLM_API_KEY=

# Canva Connect API (for design_canva_post skill)
# Lấy token tại: https://www.canva.com/developers/ → Integration → Generate token
CANVA_API_TOKEN=
