# ─────────────────────────────────────────
# Xanax Hub Server – Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Server
HUB_HOST=0.0.0.0
HUB_PORT=8000
HUB_DEBUG=true
# HUB_TITLE và HUB_VERSION cố ý KHÔNG khai ở đây.
# Tên và số phiên bản là thuộc tính của mã nguồn, không phải cấu hình theo máy —
# nguồn duy nhất là hub/config.py. Khai lại ở .env thì .env sẽ ĐÈ lên code, và
# sửa version trong config.py sẽ không có tác dụng gì.

# Security
HUB_SECRET_KEY=change-me-to-a-strong-random-secret
HUB_API_KEY=xanax-dev-key-0000
# Keep this stable after first use; changing it makes encrypted skill secrets unreadable.
XANAX_SECRET_KEY=

# Database
# Defaults to the absolute backend/xanax.db path derived by hub/config.py.
# HUB_DATABASE_URL=sqlite+aiosqlite:///D:/xanax/backend/xanax.db

# Hermes Agent
HUB_HERMES_MAX_ITERATIONS=10
HUB_HERMES_MEMORY_TTL=3600
HUB_HERMES_LOG_LEVEL=INFO
HUB_HERMES_GATEWAY_URL=http://localhost:8642
HUB_HERMES_API_KEY=

# Task Queue
HUB_TASK_QUEUE_MAX_SIZE=1000
HUB_TASK_WORKER_COUNT=4

# Giới hạn tổng thời gian chạy Claude/Codex CLI, tính bằng giây.
HUB_CLI_TIMEOUT_SECONDS=600

# Optional: LLM backend (for planning)
# Ollama hoặc bất kỳ endpoint OpenAI-compatible nào.
# Chú thích phải nằm trên dòng riêng: systemd EnvironmentFile KHÔNG cắt phần
# "# ..." ở cuối dòng, nó nuốt luôn vào giá trị biến.
HUB_LLM_API_BASE=http://localhost:11434
HUB_LLM_MODEL=hermes3
HUB_LLM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Production — sao chép các giá trị này sang cấu hình deploy và bỏ dấu #
# Backend chỉ nghe loopback; reverse proxy chịu trách nhiệm TLS/public Internet.
# HUB_HOST=127.0.0.1
# HUB_DEBUG=false
# XANAX_NO_BROWSER=1
# HUB_TASK_WORKER_COUNT=2
# Bắt buộc thay hai giá trị dev này bằng secret mạnh, không đưa secret thật vào Git.
# HUB_SECRET_KEY=<random-secret>
# HUB_API_KEY=<random-api-key>
# Cookie mặc định tự bật Secure khi HUB_DEBUG=false. Chỉ đặt false để test nội bộ qua HTTP.
# HUB_COOKIE_SECURE=true
# Giới hạn đăng nhập sai: 8 lần trong 15 phút, sau đó khóa 15 phút.
# HUB_LOGIN_RATE_LIMIT_ATTEMPTS=8
# HUB_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# HUB_LOGIN_RATE_LIMIT_LOCK_SECONDS=900
# Deploy này có Caddy tin cậy đứng trước nên bật; chạy backend trực tiếp thì để false.
# HUB_TRUST_PROXY_HEADERS=true
# Phải giữ XANAX_SECRET_KEY cố định; mất/đổi khóa sẽ làm mất khả năng đọc token skill.
# XANAX_SECRET_KEY=<stable-encryption-key>
# XANAX_ADMIN_USER=<admin-name>
# XANAX_ADMIN_PASS=<strong-password>

# Tùy chọn: ghi đè thư mục cấu hình Hermes trên mọi hệ điều hành.
# HERMES_HOME=/home/xanax/.config/hermes

# Canva Connect API (for design_canva_post skill)
# Lấy token tại: https://www.canva.com/developers/ → Integration → Generate token
CANVA_API_TOKEN=
